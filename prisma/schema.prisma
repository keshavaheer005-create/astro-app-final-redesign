generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  email          String?            @unique
  authId         String?            @unique // Supabase auth user id (sub) — set for Google / email+OTP accounts
  passwordHash   String?
  name           String?
  isGuest        Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  birthCharts    BirthChart[]
  checkIns       DailyCheckIn[]
  chatHistory    ChatMessage[]
  reflections    WeeklyReflection[]
  decisions      DecisionCheck[]
  reminderSettings ReminderSettings?
}

model BirthChart {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  dob         String // YYYY-MM-DD
  tob         String // HH:MM 24h
  lat         Float
  lng         Float
  timezone    String
  placeName   String?
  chartData   String // JSON blob of full computed chart
  isPrimary   Boolean  @default(false) // the ACTIVE chart — all journal/chat/decision data is scoped to it
  createdAt   DateTime @default(now())
  chatMessages ChatMessage[]
  checkIns     DailyCheckIn[]
  reflections  WeeklyReflection[]
  decisions    DecisionCheck[]

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartId   String? // per-chart conversation
  chart     BirthChart? @relation(fields: [chartId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  audioUrl  String? // cached TTS data URI for assistant messages
  meta      String? // JSON extras, e.g. {"journalRef":"2026-09-26"} threading the exchange to a journal entry
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([chartId, createdAt])
}

model DailyCheckIn {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartId              String?
  chart                BirthChart? @relation(fields: [chartId], references: [id], onDelete: Cascade)
  date                 String // YYYY-MM-DD, unique per chart
  moodScore            Int // 1-5
  energyScore          Int? // 1-5
  note                 String?
  microNote            String? // cached one-line Acharya interpretation
  dashaPeriodSnapshot  String // JSON {mahaLord, antarLord, mahaStart, mahaEnd, moonSign}
  createdAt            DateTime @default(now())

  @@unique([chartId, date])
  @@index([userId, date])
}

model WeeklyReflection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartId         String?
  chart           BirthChart? @relation(fields: [chartId], references: [id], onDelete: Cascade)
  weekStartDate   String // YYYY-MM-DD (Monday)
  language        String   @default("en") // letter language — one letter per week per language
  reflectionText  String
  audioUrl        String?
  createdAt       DateTime @default(now())

  @@unique([chartId, weekStartDate, language])
  @@index([userId, weekStartDate])
}

model DecisionCheck {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartId      String?
  chart        BirthChart? @relation(fields: [chartId], references: [id], onDelete: Cascade)
  decisionText String
  verdict      String // JSON verdict payload
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([chartId, createdAt])
}

model ReminderSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkinReminder   Boolean @default(true)
  reminderTime      String  @default("20:00")
  weeklyReflectionN Boolean @default(true)
}
