DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Supabase Auth (optional — activates when both values are present) ─────
# Create a project at https://supabase.com, then:
#   1. Copy the Project URL + anon public key below.
#   2. Enable Google: Authentication → Providers → Google
#      (paste your Google OAuth Client ID/Secret there — they are NOT needed here).
#   3. Run supabase/schema.sql in the SQL editor to create the profile tables.
# Until then the app uses its built-in email+password auth with guest sessions.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
